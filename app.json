{
  "expo": {
    "name": "Screenopps",
    "slug": "screenopps-mobile",
    "version": "1.0.0",
    "orientation": "default",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "backgroundColor": "#0B0D10",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#0B0D10"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "androidStatusBar": {
      "barStyle": "light-content"
    },
    "ios": {
      "supportsTablet": true,
      "userInterfaceStyle": "dark",
      "icon": "./assets/icon.png",
      "backgroundColor": "#0B0D10"
    },
    "android": {
      "userInterfaceStyle": "dark",
      "icon": "./assets/icon.png",
      "backgroundColor": "#0B0D10",
      "edgeToEdgeEnabled": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0B0D10"
      },
      "package": "com.mid9it.screenoppsmobile",
      "runtimeVersion": {
        "policy": "appVersion"
      }
    },
    "web": {
      "backgroundColor": "#0B0D10"
    },
    "extra": {
      "eas": {
        "projectId": "4bfad794-001f-4bb6-990d-e3c59829ccd8"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/4bfad794-001f-4bb6-990d-e3c59829ccd8",
      "checkAutomatically": "ON_ERROR_RECOVERY"
    },
    "plugins": [
      "expo-web-browser",
      "./plugins/withAdiRegistration.js",
      "expo-updates"
    ]
  }
}